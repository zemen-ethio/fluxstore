rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common validations
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Validation helper for user profile schema
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'plan', 'quotaUsed', 'quotaLimit', 'apiCallsUsed', 'apiCallsLimit'])
        && data.keys().size() <= 8
        && data.id is string
        && data.email is string
        && data.plan in ['Free', 'Pro', 'Enterprise']
        && data.quotaUsed is number
        && data.quotaLimit is number
        && data.apiCallsUsed is number
        && data.apiCallsLimit is number;
    }

    // Validation helper for compression jobs schema
    function isValidJob(data) {
      return data.keys().hasAll(['id', 'timestamp', 'fileName', 'fileType', 'originalSize', 'compressedSize', 'method', 'compressionRatio', 'savingsPercent', 'speedMs', 'status', 'userId', 'aiRecommended'])
        && data.id is string
        && data.timestamp is string
        && data.fileName is string
        && data.fileType is string
        && data.originalSize is number
        && data.compressedSize is number
        && data.method is string
        && data.compressionRatio is number
        && data.savingsPercent is number
        && data.speedMs is number
        && data.status is string
        && data.userId is string
        && data.aiRecommended is bool;
    }

    // Validation helper for usage log schema
    function isValidLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'userId', 'action', 'bytesProcessed', 'creditsCost'])
        && data.id is string
        && data.timestamp is string
        && data.userId is string
        && data.action is string
        && data.bytesProcessed is number
        && data.creditsCost is number;
    }

    // Validation helper for analytics schema
    function isValidAnalytics(data) {
      return data.keys().hasAll(['id', 'timestamp', 'eventType', 'payload'])
        && data.id is string
        && data.timestamp is string
        && data.eventType is string
        && data.payload is map;
    }

    // Validation helper for transfers schema
    function isValidTransfer(data) {
      return data.keys().hasAll(['id', 'senderEmail', 'recipientEmail', 'fileName', 'downloadUrl', 'timestamp'])
        && data.id is string
        && data.senderEmail is string
        && data.recipientEmail is string
        && data.fileName is string
        && data.downloadUrl is string
        && data.timestamp is string;
    }

    // Since the Node backend executes as an unauthenticated Firebase client (relying on memory DB + Firestore backing),
    // we authorize read/write operations by verifying precise schema shape, types, and sizes.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if false; // profiles are immortal
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create, update: if isValidId(jobId) && isValidJob(request.resource.data);
      allow delete: if true;
    }

    match /logs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId) && isValidLog(request.resource.data);
      allow delete: if true;
    }

    match /analytics/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId) && isValidAnalytics(request.resource.data);
      allow delete: if true;
    }

    match /transfers/{transferId} {
      allow read: if true;
      allow create, update: if isValidId(transferId) && isValidTransfer(request.resource.data);
      allow delete: if false;
    }
  }
}
